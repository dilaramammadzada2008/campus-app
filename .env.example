# Copy this file to .env and fill in your own values. Never commit .env.

# API key from https://resend.com/api-keys (leave empty for dev mode: codes are shown on screen)
RESEND_API_KEY=

# Sender. onboarding@resend.dev works without a domain, but only delivers to your own Resend account e-mail.
# After verifying a domain in Resend, use e.g. Campus Life <login@yourdomain.com>
RESEND_FROM=Campus Life <onboarding@resend.dev>

# Gmail sending (any recipient, no domain needed). When both are set, Gmail is used instead of Resend.
# App Password: https://myaccount.google.com/apppasswords (needs 2-Step Verification on the Google account).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Who can open the Admin page and approve room requests (comma-separated e-mails).
ADMIN_EMAILS=

# Comma-separated e-mail domains allowed to sign up. Add e.g. gmail.com while testing.
ALLOWED_EMAIL_DOMAINS=stud.vilniustech.lt,vilniustech.lt
